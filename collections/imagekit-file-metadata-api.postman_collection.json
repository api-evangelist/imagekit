        {
          "id": "fba66e49-ed3a-45ef-9165-bc30c9fbca5f",
          "name": "Get uploaded file metadata",
          "request": {
            "name": "Get uploaded file metadata",
            "description": {
              "content": "You can programmatically get image EXIF, pHash, and other metadata for uploaded files in the ImageKit.io media library using this API.\n\nYou can also get the metadata in upload API response by passing `metadata` in `responseFields` parameter.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "files",
                ":fileId",
                "metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "fileId",
                  "description": "(Required) The unique `fileId` of the uploaded file. `fileId` is returned in the list and search assets API and upload API.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
