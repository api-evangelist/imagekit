            "description": {
              "content": "Get image EXIF, pHash, and other metadata from ImageKit.io powered remote URL using this API.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "(Required) Should be a valid file URL. It should be accessible using your ImageKit.io account.\n"
                }
              ],
              "variable": []
            },
            "header": [
